# 已启用。由 percolation-dream.timer 每晚触发，处理全部脏租户（含网页端自动开的 sp-<uuid> 租户）。
# 手动补跑：systemctl start percolation-dream.service；日志：journalctl -u percolation-dream
[Unit]
Description=Percolation nightly dreaming
After=network-online.target remote-fs.target
Requires=remote-fs.target

[Service]
Type=oneshot
WorkingDirectory=/root/Percolation
ExecStart=/root/Percolation/code/.venv/bin/python script/percolation_cli.py dream --all
TimeoutStartSec=2h
Nice=10
