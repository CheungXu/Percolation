# 拾记凝境网页端（percolation.api + code/web/）。进程环境变量优先于本文件。

# star_page：线上模式，复用星页同域登录态（stars-page.com 的 sp_session cookie），每个星页账号一个独立租户，
#            忽略 X-User-Slug，关闭 /v1/dream 与接口文档。
# header：本机调试，X-User-Slug 选租户，缺省为 storage.env 的默认用户。只能监听 127.0.0.1。
AUTH_MODE=star_page

# 向星页换账号：本机 Nginx 内部入口 127.0.0.1:8080 直达星页 web 实例，cookie 原样转发。
STAR_PAGE_AUTH_URL=http://127.0.0.1:8080/api/auth/me
STAR_PAGE_SESSION_COOKIE=sp_session

# 网页内登录直接调星页的 /api/auth/sms/send、/api/auth/sms/login（同域）。
# 协议版本与星页前端 code/frontend/app/legal/docs.ts 的 LEGAL_POLICY_VERSION 保持一致。
STAR_PAGE_AGREEMENT_VERSION=2026-10-13
STAR_PAGE_TERMS_URL=/terms
STAR_PAGE_PRIVACY_URL=/privacy

# 每个账号滚动 24 小时内的上限；0 表示不限。询问含澄清重查。
DAILY_ASK_LIMIT=200
DAILY_CAPTURE_LIMIT=1000

# 网页静态文件目录，缺省为仓库内 code/web。
# WEB_DIR=
