# 由 script/phoenix.sh init-db 自动生成 config/phoenix.env（600），一般无需手写。
PHOENIX_SQL_DATABASE_URL=postgresql://percolation_obs:<password>@<rds-host>:5432/percolation_obs
PHOENIX_SQL_DATABASE_SCHEMA=phoenix
PHOENIX_HOST=127.0.0.1
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_ENABLE_AUTH=true
PHOENIX_SECRET=<32+ 位，含数字和小写字母>
PHOENIX_ADMIN_SECRET=<另一个 32+ 位密钥，可作 OTLP Bearer>
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=<UI admin@localhost 初始密码>
PHOENIX_TELEMETRY_ENABLED=false
PHOENIX_DISABLE_MODEL_COST_AUTO_UPDATE=true
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=90
