# 复制为 config/observability.env（chmod 600）。所有项都可被同名进程环境变量覆盖。
# 轨迹仓根目录：与 workspaces/ 平级，0700，不挂进任何沙箱，与用户数据隔离
TELEMETRY_ROOT=/mnt/percolation/telemetry
# full：完整 messages、思考链、工具原文；summary：只留 span 树、属性、用量
TRACE_LEVEL=full
# 超过这个字符数的文本外置到 blobs/（内容寻址去重）
TRACE_BLOB_THRESHOLD=16384
# 单次运行预算护栏（人民币 / 输入+输出 token），超出直接终止并记为失败；留空表示不限制
RUN_MAX_COST_CNY=5
RUN_MAX_TOKENS=3000000
# OTLP/HTTP 导出（Phoenix 本机实例）；OTLP_ENDPOINT 留空则只落 NAS
OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTLP_PROJECT=percolation
# 逗号分隔的 k=v；Phoenix 开启认证时填 PHOENIX_ADMIN_SECRET 或 API Key
OTLP_HEADERS=Authorization=Bearer <phoenix-admin-secret-or-api-key>
